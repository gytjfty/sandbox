#version 300 es
precision highp float;
precision highp int;
in vec2 screen;
out vec4 color;
uniform sampler2D tree;
uniform int treeWidth,nodeCount,editCount,fillCount,previewState;
uniform vec3 cam,up,forward,right,viewUp;
uniform vec4 preview;
uniform float altitude,aspect,tanHalf;
const float R=6371000.0;
vec4 dataAt(int i){return texelFetch(tree,ivec2(i%treeWidth,i/treeWidth),0);}
float epsilon(float t){return max(.002,abs(t)*.0000002);}
bool solidAt(vec3 p,bool base){int node=0,latest=0;bool solid=base;while(node<nodeCount){vec4 lo=dataAt(node*3),hi=dataAt(node*3+1);if(any(lessThan(p,lo.xyz))||any(greaterThan(p,hi.xyz))){node=int(lo.w+.5);continue;}if(hi.w<.5){node++;continue;}vec4 sphere=dataAt(node*3+2);vec3 d=p-sphere.xyz;int order=int(hi.w+.5);if(order>latest&&(!(fract(hi.w)>.125)||base)&&dot(d,d)<=sphere.w*sphere.w){latest=order;solid=sphere.w<0.0;}node++;}return solid;}
bool nextBoundary(vec3 ray,float after,inout float best,inout vec3 normal){bool found=false;int node=0;vec3 inv=mix(vec3(-1),vec3(1),greaterThanEqual(ray,vec3(0)))/max(abs(ray),vec3(1e-20));float eps=epsilon(after);while(node<nodeCount){vec4 lo=dataAt(node*3),hi=dataAt(node*3+1);vec3 a=(lo.xyz-cam)*inv,b=(hi.xyz-cam)*inv,low=min(a,b),high=max(a,b);float enter=max(max(low.x,low.y),low.z),exit=min(min(high.x,high.y),high.z);if(exit<max(enter,after+eps)||enter>best){node=int(lo.w+.5);continue;}if(hi.w<.5){node++;continue;}vec4 sphere=dataAt(node*3+2);vec3 c=sphere.xyz-cam;float along=dot(c,ray);vec3 perp=c-ray*along;float disc=sphere.w*sphere.w-dot(perp,perp);if(disc>=0.0){float root=sqrt(disc),t=along-root;if(t<=after+eps)t=along+root;if(t>after+eps&&t<best){best=t;normal=normalize(cam+ray*t-sphere.xyz);if(dot(normal,ray)>0.0)normal=-normal;found=true;}}node++;}return found;}
bool trace(vec3 ray,out float t,out vec3 normal,out bool changed){float b=(R+altitude)*dot(up,ray),c=altitude*(2.0*R+altitude),h=b*b-c;bool planetHit=h>=0.0;float nearT=1e30,farT=-1e30;if(planetHit){float root=sqrt(max(0.0,h));farT=-b+root;nearT=c>0.0&&b<0.0?c/max(-b+root,.000001):-b-root;if(farT<.02)planetHit=false;}
 if(fillCount==0){if(!planetHit)return false;t=max(.02,nearT);normal=normalize(up*(R+altitude)+ray*t);changed=false;int node=0,advances=0;while(node<nodeCount){vec3 point=cam+ray*t;vec4 lo=dataAt(node*3),hi=dataAt(node*3+1);if(any(lessThan(point,lo.xyz))||any(greaterThan(point,hi.xyz))){node=int(lo.w+.5);continue;}if(hi.w<.5){node++;continue;}vec4 sphere=dataAt(node*3+2);vec3 offset=point-sphere.xyz;float eps=epsilon(t);if(dot(offset,offset)>(sphere.w+eps)*(sphere.w+eps)){node++;continue;}vec3 center=sphere.xyz-cam;float along=dot(center,ray);vec3 perp=center-ray*along;float disc=sphere.w*sphere.w-dot(perp,perp);if(disc<0.0){node++;continue;}float exitT=along+sqrt(disc);if(exitT<=t+eps){node++;continue;}t=exitT;if(t>=farT)return false;normal=-normalize(cam+ray*t-sphere.xyz);changed=true;if(++advances>editCount)return false;node=0;}return t<farT;}
 t=.02;changed=true;normal=-ray;bool base=planetHit&&t>=nearT&&t<=farT;if(solidAt(cam+ray*t,base))return true;
 for(int event=0;event<editCount*2+4;event++){float best=1e30;vec3 n=vec3(0);bool found=false,planetBoundary=false;float eps=epsilon(t);if(planetHit){float candidate=nearT>t+eps?nearT:farT;if(candidate>t+eps&&candidate<best){best=candidate;n=normalize(up*(R+altitude)+ray*best);if(dot(n,ray)>0.0)n=-n;found=true;planetBoundary=true;}}if(nextBoundary(ray,t,best,n)){found=true;planetBoundary=false;}if(!found)return false;t=best;float sampleT=t+epsilon(t);base=planetHit&&sampleT>=nearT&&sampleT<=farT;if(solidAt(cam+ray*sampleT,base)){normal=n;changed=!planetBoundary;return true;}}
 return false;}
void main(){vec3 ray=normalize(forward+right*(screen.x*aspect*tanHalf)+viewUp*(screen.y*tanHalf));float t;vec3 normal;bool changed;bool hit=trace(ray,t,normal,changed);vec3 result=vec3(.006,.008,.014);if(hit){vec3 base;if(changed){base=vec3(.32,.28,.22)*(.92+.08*sin(dot(cam+ray*t,vec3(.13,.17,.11))));}else{float bands=sin(normal.x*17.0+sin(normal.z*23.0)*2.0)+sin(normal.y*29.0+normal.z*11.0)*.45;base=mix(vec3(.18,.23,.12),vec3(.34,.32,.20),smoothstep(-.7,.9,bands));base=mix(base,vec3(.72,.76,.75),smoothstep(.86,.98,abs(normal.y)));}float sun=max(0.0,dot(normal,normalize(vec3(1,.6,1)))),lamp=max(0.0,dot(normal,-ray))/(1.0+t*t*.008);vec3 lighting=changed?vec3(.18)+vec3(.6,.55,.48)*sun+vec3(1.2,1.05,.85)*lamp:vec3(.25)+vec3(.85,.79,.68)*sun+vec3(.5)*lamp;result=base*lighting;result=pow(result/(result+vec3(.65)),vec3(1.0/2.2));}
 if(previewState>0){vec3 c=preview.xyz-cam;float a=dot(c,ray);vec3 p=c-ray*a;float h=preview.w*preview.w-dot(p,p);if(h>0.0){float entry=a-sqrt(h);if(entry>0.0&&(!hit||entry<t)){vec3 pn=normalize(cam+ray*entry-preview.xyz);float edge=pow(1.0-abs(dot(pn,ray)),2.0);vec3 tint=previewState==2?vec3(1,.12,.08):vec3(1,.68,.12);result=mix(result,tint,.18+edge*.5);}}}color=vec4(result,1);}
